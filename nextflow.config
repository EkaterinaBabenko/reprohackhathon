/*
 * ============================================================================
 *  nextflow.config - Projet 1 : RNA-Seq persisters de S. aureus (Reprohackathon)
 * ============================================================================
 *  Propriétaire : A (architecture). Les autres proposent des changements par PR.
 *
 *  Utilisation :
 *    nextflow run main.nf -profile vm,apptainer             # run complet sur la VM
 *    nextflow run main.nf -profile test,vm,apptainer        # run rapide (jeu test)
 *    nextflow run main.nf -profile vm,docker -resume        # avec Docker
 *
 *  Contrat avec les modules : les noms de process ci-dessous doivent correspondre
 *  EXACTEMENT aux noms des process dans modules/*.nf :
 *    DOWNLOAD_SRA, DOWNLOAD_REF, TRIMMING, BOWTIE_INDEX, BOWTIE_MAP,
 *    FEATURECOUNTS, DESEQ2   (+ FASTQC si vous l'ajoutez)
 * ============================================================================
 */

manifest {
    name            = 'reprohackathon-persisters'
    description     = 'Reproduction de Peyrusson et al. 2020 (Nat. Commun.) : DEG persisters vs control'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

/* ----------------------------------------------------------------------------
 *  Paramètres (surchargeables en ligne de commande : --outdir autre_dossier)
 * -------------------------------------------------------------------------- */
params {
    // --- Entrées / sorties ---
    samplesheet        = 'samplesheet.csv'   // colonnes : sample,condition,srr
    outdir             = 'results'

    // --- Référence : S. aureus NCTC 8325 (CP000253.1) ---
    // (si vous changez d'accession, modifiez aussi l'id= dans les deux URL)
    genome_url         = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=CP000253.1&rettype=fasta'
    gff_url            = 'https://www.ncbi.nlm.nih.gov/sviewer/viewer.cgi?db=nuccore&report=gff3&id=CP000253.1'

    // --- Trimming (cutadapt 1.11 dans le papier) ---
    cutadapt_quality   = 20                  // -q : HYPOTHÈSE (non précisé dans le papier)
    cutadapt_minlen    = 25                  // -m : donné par le papier
    cutadapt_adapter   = null                // ex. 'AGATCGGAAGAGC' (TruSeq) ; null = pas d'option -a
                                             // -> décision à justifier dans docs/assumptions.md

    // --- Comptage (featureCounts 1.4.6-p3) ---
    fc_feature         = 'gene'              // -t
    fc_attribute       = 'ID'                // -g
    fc_strand          = 1                   // -s 1 : librairie stranded, comme dans le papier
    fc_format          = 'GTF'               // -F (valeur du sujet ; à tester avec un GFF NCBI)
    fc_extra_attribute = 'Name'              // --extraAttributes

    // --- Statistiques (DESeq2) ---
    deseq2_padj        = 0.05                // seuil p ajustée (BH)
    deseq2_reference   = 'control'           // niveau de référence de la condition

    // --- Images de conteneurs (une par outil, à épingler : jamais 'latest') ---
    // Ce sont les noms des images construites depuis containers/<outil>/.
    // Si Damona propose la bonne version, remplacez par son image.
    // Avec Apptainer, vous pouvez mettre le chemin d'un .sif local ou 'docker://...'.
    containers {
        sratoolkit = 'reprohack/sratoolkit:3.0.0'
        cutadapt   = 'reprohack/cutadapt:1.11'
        fastqc     = 'reprohack/fastqc:0.12.1'
        bowtie     = 'reprohack/bowtie-samtools:0.12.7'   // bowtie 1 + samtools
        subread    = 'reprohack/subread:1.4.6-p3'
        deseq2     = 'reprohack/deseq2:1.16'
    }
}

/* ----------------------------------------------------------------------------
 *  Réglages généraux des process
 * -------------------------------------------------------------------------- */
process {
    // bash strict : indispensable pour la substitution de processus <(gunzip -c ...)
    // du mapping bowtie, et pour que les erreurs dans un pipe fassent échouer la tâche
    shell         = ['/bin/bash', '-euo', 'pipefail']

    // Ressources par défaut (surchargées par process plus bas)
    cpus          = 1
    memory        = { 2.GB * task.attempt }
    time          = { 2.h * task.attempt }

    // Relance une fois si le process est tué (mémoire / temps), sinon arrêt
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1

    // --- 1. Données (module B) ---
    withName: 'DOWNLOAD_SRA' {
        container  = params.containers.sratoolkit
        cpus       = 4
        memory     = { 4.GB * task.attempt }
        maxForks   = 2                       // évite de saturer le NCBI et le disque
        publishDir = [path: "${params.outdir}/01_download/fastq", mode: 'copy']
    }
    withName: 'DOWNLOAD_REF' {
        // wget : un conteneur minimal suffit ; ici on réutilise l'image sratoolkit
        // (remplacez par une image contenant wget si elle n'en a pas)
        container  = params.containers.sratoolkit
        publishDir = [path: "${params.outdir}/01_download/reference", mode: 'copy']
    }
    withName: 'FASTQC' {
        container  = params.containers.fastqc
        cpus       = 2
        publishDir = [path: "${params.outdir}/02_qc", mode: 'copy']
    }
    withName: 'TRIMMING' {
        container  = params.containers.cutadapt
        cpus       = 2
        publishDir = [path: "${params.outdir}/02_trimming", mode: 'copy']
    }

    // --- 2. Mapping et comptage (module C) ---
    withName: 'BOWTIE_INDEX' {
        container  = params.containers.bowtie
        cpus       = 2
        publishDir = [path: "${params.outdir}/03_mapping/index", mode: 'copy']
    }
    withName: 'BOWTIE_MAP' {
        container  = params.containers.bowtie
        cpus       = 4
        memory     = { 4.GB * task.attempt }
        publishDir = [path: "${params.outdir}/03_mapping/bam", mode: 'copy']
    }
    withName: 'FEATURECOUNTS' {
        container  = params.containers.subread
        cpus       = 4
        publishDir = [path: "${params.outdir}/04_counts", mode: 'copy']
    }

    // --- 3. Statistiques et figures (module D) ---
    withName: 'DESEQ2' {
        container  = params.containers.deseq2
        cpus       = 2
        memory     = { 4.GB * task.attempt }
        publishDir = [path: "${params.outdir}/05_deseq2", mode: 'copy']
    }
}

/* ----------------------------------------------------------------------------
 *  Rapports d'exécution (utiles pour le rapport et pour déboguer)
 * -------------------------------------------------------------------------- */
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}

/* ----------------------------------------------------------------------------
 *  Profils : combinez un profil d'environnement et un moteur de conteneurs
 *     -profile vm,apptainer      -profile test,vm,docker      etc.
 * -------------------------------------------------------------------------- */
profiles {

    // ---- Où on exécute ----
    standard {
        process.executor = 'local'
    }

    // VM de l'université : ADAPTEZ cpus et memory à la VM (commandes `nproc`, `free -g`)
    vm {
        process.executor = 'local'
        executor {
            cpus   = 8
            memory = '16 GB'
        }
    }

    // ---- Moteur de conteneurs ----
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'   // fichiers produits à votre nom, pas root
        apptainer.enabled = false
        singularity.enabled = false
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // astuce : exporter NXF_APPTAINER_CACHEDIR=/chemin/avec/de/la/place avant le run
        docker.enabled       = false
        singularity.enabled  = false
    }

    // Pour Nextflow < 22.04 ou si Apptainer s'appelle encore Singularity sur la VM
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
    }

    // ---- Jeu de test minuscule pour développer vite ----
    test {
        params.samplesheet = 'test/samplesheet_test.csv'   // 1 ou 2 runs, FASTQ sous-échantillonnés
        params.outdir      = 'results_test'
        process {
            // limites basses : tout doit tenir sur un portable
            withName: 'DOWNLOAD_SRA'   { cpus = 2 }
            withName: 'BOWTIE_MAP'     { cpus = 2 }
            withName: 'FEATURECOUNTS'  { cpus = 2 }
        }
    }
}

/* Dossier de travail (ne pas versionner : ajouter work/ au .gitignore) */
workDir = 'work'