params {
    cutadapt_quality = 20
    cutadapt_minlen = 25
    outdir = 'results'
}

profiles {
    docker {
        docker.enabled = true
    }
}

process {
    withName: 'TRIMMING' {
        container = 'quay.io/biocontainers/cutadapt:4.4--py310h1425a21_0'
        cpus = 2
        publishDir = [
            path: "${params.outdir}/02_trimming",
            mode: 'copy'
        ]
    }
}
