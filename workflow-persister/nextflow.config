docker.enabled = true

/*
 * Pipeline parameters
 */

 params {
    samplesheet = 'data/samples.csv' // colonnes : sample, condition, SRA_id
 }

/*
* Output settings
*/

outputDir = "results/"
workflow.output.mode = 'copy'

/*
 * Workdir setting
 */
workDir = 'work/'
/*
 * Ressources (CPUs) par process
 * Utilisées via ${task.cpus} dans les modules
 */
process {
    cpus = 1
    withName: 'DOWNLOAD_SRA'   { cpus = 4 }
    withName: 'BOWTIE_MAP'     { cpus = 4 }
    withName: 'FEATURECOUNTS'  { cpus = 4 }
}
