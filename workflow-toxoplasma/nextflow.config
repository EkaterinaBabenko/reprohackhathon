/*
 * ============================================================================
 *  nextflow.config - Projet 2 : Toxoplasma gondii mouse brain RNA-Seq
 *  (Hu et al., Frontiers in Microbiology 2020, reproduction de la Fig. 2B)
 * ============================================================================
 */

docker.enabled = true

/*
 * Pipeline parameters
 */

params {
    // --- Entrées / sorties ---
    samplesheet = 'data/samples.csv'   // colonnes : sample, condition, timepoint, SRR
    outdir      = 'results'

    // --- Seuils de l'article de Hu et al. 2020 (Fig. 2B) : p-value < 0.05 NON
    //     ajustée et |log2 fold-change| >= 1.5 ---
    deseq2_pvalue = 0.05
    deseq2_log2fc = 1.5

    // --- Images de conteneurs (une par outil, épinglées : jamais 'latest' sauf image locale) ---
    // Trimmomatic 0.39 et Salmon 1.2.0 sont fournis sur Damona (cokelaer.github.io/damona,
    // ou `damona search trimmomatic` / `damona search salmon`) : remplacer par les noms
    // d'images exacts trouvés. DESeq2 : image locale construite depuis ../deseq2/Dockerfile.
    containers {
        sratoolkit  = 'staphb/sratoolkit'
        trimmomatic = 'staphb/trimmomatic:0.39'                  // À CONFIRMER via damona search trimmomatic
        salmon      = 'getwilds/salmon:1.10.3'                       // À CONFIRMER via damona search salmon
        gffread     = 'getwilds/gffread'
        deseq2      = 'deseq2:latest'                             // docker build -t deseq2:latest ../deseq2/
    }
}

/*
 *  Process parameters
 */
process {

    // --- 1. Données ---
    withName: 'DOWNLOAD_SRA' {
        container  = params.containers.sratoolkit
        cpus       = 4
        memory     = '4 GB'
        maxForks   = 2   // évite de saturer le NCBI et le disque
        publishDir = [path: "${params.outdir}/01_download/fastq", mode: 'copy']
    }
    withName: 'DOWNLOAD_REF' {
        container  = params.containers.sratoolkit   // wget suffit
        cpus       = 1
        memory     = '2 GB'
        publishDir = [path: "${params.outdir}/01_download/reference", mode: 'copy']
    }

    // --- 2. Trimming ---
    withName: 'TRIMMING' {
        container  = params.containers.trimmomatic
        cpus       = 2
        memory     = '4 GB'
        publishDir = [path: "${params.outdir}/02_trimming", mode: 'copy']
    }

    // --- 3. Référence : transcriptome + index Salmon ---
    withName: 'BUILD_TRANSCRIPTOME' {
        container  = params.containers.gffread
        cpus       = 8
        memory     = '32 GB'
        publishDir = [path: "${params.outdir}/03_reference/transcriptome", mode: 'copy']
    }
    withName: 'SALMON_INDEX' {
        container  = params.containers.salmon
        cpus       = 8
        memory     = '32 GB'
        publishDir = [path: "${params.outdir}/03_reference/salmon_index", mode: 'copy']
    }

    // --- 4. Quantification par échantillon ---
    withName: 'SALMON_QUANT' {
        container  = params.containers.salmon
        cpus       = 4
        memory     = '16 GB'
        publishDir = [path: "${params.outdir}/04_quant", mode: 'copy']
    }

    // --- 5. Expression différentielle ---
    withName: 'DESEQ2' {
        container  = params.containers.deseq2
        cpus       = 4
        memory     = '16 GB'
        publishDir = [path: "${params.outdir}/05_deseq2", mode: 'copy']
    }
}

/*
* Output settings
*/
outputDir = "results/"
workflow.output.mode = 'copy'

/*
 * Workdir setting
 */
workDir = 'work/'
