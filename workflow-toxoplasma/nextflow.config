/*
 * ============================================================================
 *  nextflow.config - Projet 2 : Toxoplasma gondii mouse brain RNA-Seq
 *  (Hu et al., Frontiers in Microbiology 2020, reproduction de la Fig. 2B)
 * ============================================================================
 */

apptainer.enabled    = true
apptainer.autoMounts = true

/*
 * Pipeline parameters
 */

params {
    // --- Entrées / sorties ---
    samplesheet = 'data/samples.csv'   // colonnes : sample, condition, timepoint, SRR
    outdir      = 'results'

    // --- Seuils de l'article de Hu et al. 2020 (Fig. 2B) : p-value < 0.05 NON
    //     ajustée et |log2 fold-change| >= 1.5 ---
    deseq2_pvalue = 0.05
    deseq2_log2fc = 1.5

    // --- Référence : génome souris GRCm38, Ensembl release 100 ---
    genome_url = 'https://ftp.ensembl.org/pub/release-100/fasta/mus_musculus/dna/Mus_musculus.GRCm38.dna.toplevel.fa.gz'
    gff_url    = 'https://ftp.ensembl.org/pub/release-100/gff3/mus_musculus/Mus_musculus.GRCm38.100.gff3.gz'

    containers {
        sratoolkit  = baseDir + '/containers/sratoolkit-pigz_3.4.1.sif'
        trimmomatic = projectDir + '/containers/trimmomatic_0.39.0.img'  // image Apptainer locale (Zenodo 22144681)
        salmon      = projectDir + '/containers/salmon_1.2.0.img'   // image Apptainer locale (Zenodo 22144522)
        gffread     = 'docker://getwilds/gffread'
        deseq2      = 'docker://getwilds/deseq2'
    }
}

/*
 *  Process parameters
 */
process {

    // --- 1. Données ---
    withName: 'DOWNLOAD_SRA' {
        container  = params.containers.sratoolkit
        cpus       = 4
        memory     = '4 GB'
        maxForks   = 6   // évite de saturer le NCBI et le disque
        publishDir = [path: "${params.outdir}/01_download/fastq", mode: 'copy']
    }
    withName: 'DOWNLOAD_REF' {
        container  = params.containers.sratoolkit   // wget suffit
        cpus       = 1
        memory     = '2 GB'
        publishDir = [path: "${params.outdir}/01_download/reference", mode: 'copy']
    }

    // --- 2. Trimming ---
    withName: 'TRIMMING' {
        container  = params.containers.trimmomatic
        cpus       = 4
        memory     = '4 GB'
        publishDir = [path: "${params.outdir}/02_trimming", mode: 'copy']
    }

    // --- 3. Référence : transcriptome + index Salmon ---
    withName: 'BUILD_TRANSCRIPTOME' {
        container  = params.containers.gffread
        cpus       = 4
        memory     = '32 GB'
        publishDir = [path: "${params.outdir}/03_reference/transcriptome", mode: 'copy']
    }
    withName: 'SALMON_INDEX' {
        container  = params.containers.salmon
        cpus       = 4
        memory     = '32 GB'
        publishDir = [path: "${params.outdir}/03_reference/salmon_index", mode: 'copy']
    }

    // --- 4. Quantification par échantillon ---
    withName: 'SALMON_QUANT' {
        container  = params.containers.salmon
        cpus       = 4
        memory     = '16 GB'
        publishDir = [path: "${params.outdir}/04_quant", mode: 'copy']
    }

    // --- 5. Expression différentielle ---
    withName: 'DESEQ2' {
        container  = params.containers.deseq2
        cpus       = 24
        memory     = '16 GB'
        publishDir = [path: "${params.outdir}/05_deseq2", mode: 'copy']
    }

    // --- 6. Venn des DETs d11 vs d33 (Fig. 2B) ---
    withName: 'VENN' {
        container  = params.containers.deseq2   // R de l'image DESeq2 suffit
        cpus       = 8
        memory     = '2 GB'
        publishDir = [path: "${params.outdir}/06_venn", mode: 'copy']
    }
}

/*
* Output settings
*/
outputDir = "results/"
workflow.output.mode = 'copy'

/*
 * Workdir setting
 */
workDir = 'work/'
