docker.enabled = true

/*
 * Pipeline parameters
 */

 params {
    samplesheet = 'data/samples.csv' // colonnes : sample, condition, timepoint, SRR
    outdir      = 'results'

    // Seuils de l'article de Hu et al. 2020 (Fig. 2B) : p-value < 0.05 NON ajustée
    // et |log2 fold-change| >= 1.5
    deseq2_pvalue = 0.05
    deseq2_log2fc = 1.5

    // Conteneurs. Trimmomatic 0.39 et Salmon 1.2.0 sont fournis sur Damona
    // (cokelaer.github.io/damona, ou `damona search trimmomatic` / `damona search salmon`) :
    // à compléter avec les noms d'images exacts après le damona search.
    containers {
        trimmomatic = 'damona/trimmomatic:0.39'   // À CONFIRMER via damona search trimmomatic
        salmon      = 'damona/salmon:1.2.0'      // À CONFIRMER via damona search salmon
        gffread     = 'biocontainers/gffread:v0.12.7_cv1'
    }
 }

/*
* Output settings
*/

outputDir = "results/"
workflow.output.mode = 'copy'
